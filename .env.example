# ===== LLM 服务（OpenAI 兼容 HTTP 接口） =====
# LLM 服务 Base URL（OpenAI 兼容网关地址，例如 https://api.openai.com/v1 或自建网关）
LLM_BASE_URL=https://api.openai.com/v1
# LLM 服务 API Key（示例占位，严禁填写真实密钥并提交）
LLM_API_KEY=your-api-key-here
# 对话模型名称（按所用服务填写）
LLM_MODEL=your-model-name

# ===== 嵌入（Embedding）服务 =====
# 嵌入模型名称
EMBEDDING_MODEL=your-embedding-model
# 嵌入服务 Base URL（留空则回退到 LLM_BASE_URL）
EMBEDDING_BASE_URL=https://api.openai.com/v1
